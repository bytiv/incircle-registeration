# Copy to .env.local for local dev, and paste the same keys into Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...                # SECRET. server-side only (the "service_role" / secret key)

# The control room's passcode (/admin)
ADMIN_PASSCODE=

# Optional. The welcome email (Settings → WELCOME EMAIL), sent through Resend the moment someone
# registers. Nothing is sent until both are set. Resend → API Keys (Sending access):
RESEND_API_KEY=
# An address on a domain verified in Resend → Domains, with the name people see:
EMAIL_FROM="InCircle <hello@incircle.community>"
# Optional. Where a reply lands, when EMAIL_FROM is not a real inbox:
EMAIL_REPLY_TO=

# Where this app is reachable, e.g. https://incircle-registeration.vercel.app — the address the
# Registration page prints as the public link, and the one the page's share previews use. Set it
# on Vercel: without it both fall back to the deployment's own address, which Vercel's default
# Deployment Protection puts behind a Vercel login.
NEXT_PUBLIC_SITE_URL=

# Optional. Which event to use when none is marked active in the database (events.slug).
NEXT_PUBLIC_EVENT_SLUG=incircle

# Optional. The time zone every clock in the control room shows. Default Africa/Cairo.
# NEXT_PUBLIC_EVENT_TZ=Africa/Cairo
