# Copy to .env.local for local dev, and paste the same keys into Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...                # SECRET. server-side only (the "service_role" / secret key)

# The control room's passcode (/admin)
ADMIN_PASSCODE=

# Optional. Where this app is reachable, e.g. https://incircle-registration.vercel.app — the
# address the Registration page prints as the public /register link. Vercel sets
# NEXT_PUBLIC_VERCEL_URL automatically, so production needs nothing.
NEXT_PUBLIC_SITE_URL=

# Optional. Which event to use when none is marked active in the database (events.slug).
NEXT_PUBLIC_EVENT_SLUG=incircle

# Optional. The time zone every clock in the control room shows. Default Africa/Cairo.
# NEXT_PUBLIC_EVENT_TZ=Africa/Cairo
